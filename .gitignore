# JavaScript dependencies and frontend output
node_modules/
dist/

# Rust/Tauri build output
src-tauri/target/
target/

# Local secrets and environment configuration
.env
.env.*
!.env.example
*.pfx
*.p12
*.key

# Local build staging artifacts; the runtime extension packages under
# src-tauri/extensions and their notices under src-tauri/licenses stay tracked.
src-tauri/extension-staging/

# Android's generated project copies desktop-only bundled extensions on init.
# Android System WebView cannot load Chrome extensions; keep those desktop
# packages out of the Android source assets and APK.
src-tauri/gen/android/.tauri/
src-tauri/gen/android/app/build/
src-tauri/gen/android/buildSrc/build/
src-tauri/gen/android/buildSrc/.kotlin/
src-tauri/gen/android/app/src/main/assets/extensions/
src-tauri/gen/android/app/src/main/assets/licenses/extensions/

# OS/editor noise
.DS_Store
Thumbs.db
*.log
.idea/
.vscode/
