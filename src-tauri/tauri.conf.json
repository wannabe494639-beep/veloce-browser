{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Veloce Browser",
  "version": "0.1.6-beta.1",
  "identifier": "com.veloce.browser",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Veloce Browser",
        "width": 1360,
        "height": 860,
        "minWidth": 820,
        "minHeight": 560,
        "decorations": true,
        "resizable": true,
        "center": true,
        "browserExtensionsEnabled": true,
        "backgroundColor": "#101114"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob: https:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost https: wss:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "linux": {
      "appimage": {
        "bundleMediaFramework": true
      }
    },
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh",
        "installMode": "currentUser"
      }
    },
    "resources": [
      "extensions/**/*",
      "licenses/extensions/*.txt",
      "licenses/extensions/*.md"
    ]
  }
}

